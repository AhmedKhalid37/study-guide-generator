DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_dashscope_key_here
QWEN_API_KEY=your_qwen_key_here
QWEN_MODEL=qwen3.7-max

LLM_TEMPERATURE=0.2

# Attachment text caps (characters fed to the model).
# MAX_ATTACHMENT_CHARS caps a single attachment; MAX_TOTAL_ATTACHMENT_CHARS caps
# the combined text across all attachments in one job. Text past these limits is
# truncated/skipped (the UI shows a warning). Raise them to cover larger decks;
# lower them for very large decks on small-context local models that can't fit
# the full text. (Provider-aware caps are a future improvement, not yet wired.)
# MAX_ATTACHMENT_CHARS=200000
# MAX_TOTAL_ATTACHMENT_CHARS=600000

# Local models (optional)
# Run an OpenAI-compatible server such as llama.cpp on the host, then point the
# Docker container at host.docker.internal so it can reach your machine.
# LOCAL_LLM_BASE_URL=http://host.docker.internal:8080/v1
# LOCAL_LLM_API_KEY=local
# LOCAL_LLM_MODEL=your-local-model-name

# Backward-compatible generic OpenAI-style names are still accepted by the app.
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_API_KEY=local
# LLM_MODEL=your-local-model-name
